# Router address. If the container cannot resolve speedport.ip, use the router's IP, e.g. https://192.168.2.1
ROUTER_URL=https://speedport.ip

# Device password (optional; can also be entered in the dashboard). It is assigned to the
# first router identified and only ever sent to that router (matched by serial number).
# ROUTER_PASSWORD_FILE=/run/secrets/router_password reads it from a file instead.
ROUTER_PASSWORD=

# Defaults; changes in the dashboard settings take precedence.
STATUS_INTERVAL=30
DETAILS_INTERVAL=300
# Automatic speed test every N minutes (30-1440); 0 = off. Each test saturates the line for ~20 s.
SPEEDTEST_INTERVAL=0

LOG_LEVEL=INFO
